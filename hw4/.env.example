# Copy to .env and fill in. Never commit .env. Variable names only; no real values here.
# The key can also live once in the workspace-root .env, which app_config.py reads as a fallback.

# Required: Portkey API key for all model calls.
PORTKEY_API_KEY=

# Optional: model (default: gpt-5.6-luna).
OPENAI_MODEL=

# Optional: Portkey routing.
PORTKEY_BASE_URL=
PORTKEY_PROVIDER=
PORTKEY_CONFIG_ID=

# Optional: set to 1 to show full tracebacks on errors.
AGENT_DEBUG=
