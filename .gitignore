# in case a copy is ever made inside the project.
*.db
*.sqlite
*.sqlite3
data/
products/

# Environments and dependencies
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]

# Build output
dist/
build/
.vite/
coverage/

# OS cruft
.DS_Store
